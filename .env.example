# ── Optional first-run seeding of the admin / guest accounts ─────────────────
# Set to true ONLY on a brand-new database, run once, then set back to false.
VITE_SEED_DEFAULT_USERS=false
VITE_SEED_ADMIN_EMAIL=
VITE_SEED_ADMIN_PASSWORD=
VITE_SEED_GUEST_EMAIL=
VITE_SEED_GUEST_PASSWORD=
