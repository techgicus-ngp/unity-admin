# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (or `.env.local`) and fill in the values.
# Only variables prefixed with VITE_ are exposed to the browser bundle, so
# NEVER put server secrets (service-account keys etc.) in here.
# Restart `npm run dev` after changing anything.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (Console → Project settings → Your apps → Web app) ──────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Branding ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=Unity Realities Admin
# Printed at the top of every quotation PDF
VITE_COMPANY_NAME=Unity Realities
VITE_COMPANY_TAGLINE=Real Estate Quotation

# ── Layout maps (Firestore `maps` collection document ids) ───────────────────
# Map opened first on the Layout Dashboard
VITE_DEFAULT_MAP_ID=
# Comma-separated ids shown in the "Select Map" dialog. Leave empty to list
# every map. The default map is always included.
VITE_ALLOWED_MAP_IDS=

# ── Employee registration ────────────────────────────────────────────────────
# Comma-separated group names offered on the registration form
VITE_EMPLOYEE_GROUPS=Group A,Group B

# ── Optional first-run seeding of the admin / guest accounts ─────────────────
# Set to true ONLY on a brand-new database, run once, then set back to false.
VITE_SEED_DEFAULT_USERS=false
VITE_SEED_ADMIN_EMAIL=
VITE_SEED_ADMIN_PASSWORD=
VITE_SEED_GUEST_EMAIL=
VITE_SEED_GUEST_PASSWORD=
